#!/usr/bin/env bash
# Production wrapper for tag-buddy (installed copy in ~/.local/opt/tag-buddy).
# Reads the tags file path from XDG config and runs the Symfony console in prod.
set -euo pipefail

APP_DIR="$HOME/.local/opt/tag-buddy"
CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/tag-buddy/config.yaml"

# Bridge the XDG config to the env var the app expects.
if [[ -f "$CONFIG" ]]; then
  path="$(sed -n -E "s/^tags_file_path:[[:space:]]*['\"]?([^'\"]+)['\"]?[[:space:]]*\$/\1/p" "$CONFIG")"
  [[ -n "${path:-}" ]] && export TAGS_FILE_PATH="$path"
fi

# Without a tags path the app would fall back to the relative one in the shipped .env and
# resolve it against the current directory: stop instead of working on the wrong file.
if [[ -z "${TAGS_FILE_PATH:-}" ]]; then
  echo "tag-buddy: tags_file_path non impostato. Atteso in $CONFIG, nella forma: tags_file_path: '/percorso/del/file/tags.yaml'" >&2
  exit 1
fi

export APP_ENV=prod
# Resolve php under a minimal PATH (e.g. a headless launcher shell): Homebrew's bin.
export PATH="/opt/homebrew/bin:$PATH"
exec php "$APP_DIR/bin/console" "$@"
